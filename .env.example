# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase --------------------------------------------------------------
# Project ref: ldgymkxdlguowriprxpt
NEXT_PUBLIC_SUPABASE_URL=https://ldgymkxdlguowriprxpt.supabase.co
